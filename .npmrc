# @opentui/solid (every published version) declares an exact peer of
# solid-js@1.9.12, which transitively pins seroval to the 1.5.x line that
# carries four unfixed critical advisories. The OpenCode TUI itself is built
# against solid-js ~1.9.15, and it installs plugins with Bun, which tolerates
# the mismatch -- so we track 1.9.15 and get a single hoisted copy of solid-js
# that is not vulnerable.
#
# npm is strict about the stale peer and refuses to resolve. Opt out of strict
# peer checking for this repo so `npm install` works out of the box. This file
# is not published; consumers installing the package never see it.
legacy-peer-deps=true